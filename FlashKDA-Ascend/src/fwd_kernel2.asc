/**
 * FlashKDA Ascend -- Kernel 2 (Recurrence): device entry point and launch.
 *
 * See fwd_kernel1.asc for why the entry and the <<<>>> launch share a
 * translation unit and why SetSyncBaseAddr must come first.
 *
 * The recurrence is sequential in chunks within a sequence, so the grid is one
 * core per (sequence, head) rather than per tile.
 */

#include <cstdlib>

#include "flash_kda/fwd.h"
#include "flash_kda/fwd_kernel2.hpp"
#include "catlass/arch/cross_core_sync.hpp"

// TASK is KERNEL_TYPE_AIV_ONLY or KERNEL_TYPE_AIC_ONLY.
//
// Every kernel2 phase runs on exactly one core type -- the others return
// immediately via `if constexpr (g_coreType != ...)`. Without this annotation
// each launch is a mix task and starts blocks on both, so half of every launch
// is blocks that exist only to return.
//
// That matters because kernel2 is launch-bound and the cost is on the device,
// not the host: at T=4096 H=64 the host issues all 1031 launches in 2.71 ms
// (2.63 us each) while the device spends 37.15 ms, and with every phase stubbed
// the time still scales linearly with launch count at ~5.2 us each.
#define FKDA_K2_ENTRY(NAME, METHOD, TASK)                             \
    extern "C" CATLASS_GLOBAL void NAME(flash_kda::FwdParams params)  \
    {                                                                 \
        KERNEL_TASK_TYPE_DEFAULT(TASK);                               \
        flash_kda::FwdRecurrenceKernel op;                            \
        op.METHOD(params);                                            \
    }

FKDA_K2_ENTRY(FlashKdaK2BuildU, RunBuildU, KERNEL_TYPE_AIV_ONLY)
FKDA_K2_ENTRY(FlashKdaK2PreGemms, RunPreGemms, KERNEL_TYPE_AIC_ONLY)
FKDA_K2_ENTRY(FlashKdaK2FinishOut, RunFinishOut, KERNEL_TYPE_AIV_ONLY)
FKDA_K2_ENTRY(FlashKdaK2PostGemms, RunPostGemms, KERNEL_TYPE_AIC_ONLY)
FKDA_K2_ENTRY(FlashKdaK2FinishChunk, RunFinishChunk, KERNEL_TYPE_AIV_ONLY)
FKDA_K2_ENTRY(FlashKdaK2FinishAndBuild, RunFinishChunkAndBuildNext, KERNEL_TYPE_AIV_ONLY)

// The fused recurrence. MIX_AIC_1_1 because both core types run and hand off by
// cross-core flag -- without a declared task type the runtime does not
// provision FFTS sync and the first wait hangs.
extern "C" CATLASS_GLOBAL void FlashKdaK2FusedAll(flash_kda::FwdParams params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    flash_kda::FwdRecurrenceKernel op;
    op.RunFusedAll(params);
}


extern "C" CATLASS_GLOBAL void FlashKdaK2InitState(flash_kda::FwdParams params)
{
    flash_kda::FwdRecurrenceKernel op;
    op.RunInitState(params);
}

extern "C" CATLASS_GLOBAL void FlashKdaK2StoreFinal(flash_kda::FwdParams params)
{
    flash_kda::FwdRecurrenceKernel op;
    op.RunStoreFinalState(params);
}

namespace flash_kda {

void launch_fwd_recurrence(const FwdParams& params, aclrtStream stream)
{
    const int block_dim = params.N * params.H;
    if (block_dim <= 0) {
        return;
    }

    // Worst-case chunk count across sequences; shorter ones return early.
    int maxChunks = 0;
    if (params.is_varlen == 0) {
        const int seqLen = params.T_total / params.N;
        maxChunks = (seqLen + CHUNK - 1) / CHUNK;
    } else {
        // total_tiles already bounds the sum; a per-sequence bound is enough.
        maxChunks = params.total_tiles;
    }

    FlashKdaK2InitState<<<block_dim, nullptr, stream>>>(params);

    // Five launches per chunk, ordered by the stream. This replaces two
    // cross-core handshakes per chunk, which deadlock from a Python extension.
    // params is passed by value, so each launch captures the chunk index as it
    // stood at launch time.
    FwdParams p = params;
    // Only chunk 0 needs a standalone BuildU; every later chunk's is folded
    // into the previous chunk's FinishChunk, which is the same core type and
    // already adjacent. Five launches per chunk become four.
    // One kernel for the whole recurrence, when asked for. Same phases in the
    // same order; the AIC/AIV handoffs are cross-core flags rather than launch
    // boundaries, so 4 launches per chunk become 0.
    // Default. FLASH_KDA_FUSED_K2=0 falls back to the launch-per-phase path,
    // which is kept because it is the reference this was validated against.
    static const bool useFused = [] {
        const char *e = std::getenv("FLASH_KDA_FUSED_K2");
        return e == nullptr || e[0] != '0';
    }();
    if (useFused) {
        FwdParams fp = params;
        aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&fp.sync_base_addr));
        FlashKdaK2FusedAll<<<block_dim, nullptr, stream>>>(fp);
        return;
    }

    p.chunk_idx = 0;
    FlashKdaK2BuildU<<<block_dim, nullptr, stream>>>(p);

    for (int c = 0; c < maxChunks; ++c) {
        p.chunk_idx = c;
        FlashKdaK2PreGemms<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2FinishOut<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2PostGemms<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2FinishAndBuild<<<block_dim, nullptr, stream>>>(p);
    }

    FlashKdaK2StoreFinal<<<block_dim, nullptr, stream>>>(params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Cross-core handshake with a SINGLE kernel argument. The earlier probes took
// two and hung, which was the argument shape rather than the handshake -- this
// separates them. If it completes, kernel2's five-launches-per-chunk structure
// can collapse back into one kernel with the chunk loop inside.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncOneArg(flash_kda::FwdParams params)
{
    // Declare this a mix task explicitly. Both earlier attempts at cross-core
    // sync hung, and neither declared a task type -- KERNEL_TASK_TYPE turned
    // out to matter for how the runtime sets a launch up, so the FFTS sync
    // resources this handshake needs may simply never have been provisioned.
    // MIX_AIC_1_1 is one AIC block paired with one AIV block, which is the
    // ratio the handshake below assumes.
    // 1_1, not 1_2: this probe has a single AIV path and would deadlock under
    // 1_2, where both subblocks must set the flag. A global sed over this file
    // once flipped it by accident and it hung.
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);

    AscendC::SetSyncBaseAddr(params.sync_base_addr);

    Catlass::Arch::CrossCoreFlag elemReady{1};
    Catlass::Arch::CrossCoreFlag mmaReady{2};

    const int units = params.N * params.H;

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int>(core) >= units) {
            return;
        }
        if (AscendC::GetSubBlockIdx() != 0) {
            return;
        }
        for (int i = 0; i < params.chunk_idx; ++i) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int>(core) >= units) {
            return;
        }
        for (int i = 0; i < params.chunk_idx; ++i) {
            Catlass::Arch::CrossCoreWaitFlag(elemReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        }
    }
}

namespace flash_kda {

void launch_sync_onearg(const FwdParams &params, aclrtStream stream)
{
    const int block_dim = params.N * params.H;
    if (block_dim <= 0) {
        return;
    }
    FwdParams p = params;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&p.sync_base_addr));
    FlashKdaSyncOneArg<<<block_dim, nullptr, stream>>>(p);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Kimi's §1(a) probe: are cross-core flags armed PER flagId, or collectively
// over the AI Core's AIV group regardless of flagId?
//
// This decides whether a skewed pipeline is expressible. Earlier, two AIC waits
// against two AIV sets on ONE flagId deadlocked, which is consistent with two
// different rules:
//   - arming is collective over the group per flagId (one wait consumes the
//     whole group's sets), or
//   - arming is collective over the group regardless of flagId.
// Under the first, per-subblock flagIds let the two AIVs be in different
// phases. Under the second, they cannot, and only phase-symmetric flags work.
//
// Here AIV subblock 0 sets flag 3 and subblock 1 sets flag 4, and the AIC waits
// 3 then 4. If arming is per flagId this completes; if it is per group, flag 3
// is never armed by one subblock alone and it hangs.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaPerSubFlag(flash_kda::FwdParams params)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
    AscendC::SetSyncBaseAddr(params.sync_base_addr);

    Catlass::Arch::CrossCoreFlag sub0Done{3};
    Catlass::Arch::CrossCoreFlag sub1Done{4};
    Catlass::Arch::CrossCoreFlag aicDone{5};

    const int units = params.N * params.H;
    const int iters = params.chunk_idx > 0 ? params.chunk_idx : 8;

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int>(core) >= units) {
            return;
        }
        const bool isSub0 = (AscendC::GetSubBlockIdx() == 0);
        for (int i = 0; i < iters; ++i) {
            if (isSub0) {
                Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(sub0Done);
            } else {
                Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(sub1Done);
            }
            Catlass::Arch::CrossCoreWaitFlag(aicDone);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int>(core) >= units) {
            return;
        }
        for (int i = 0; i < iters; ++i) {
            Catlass::Arch::CrossCoreWaitFlag(sub0Done);
            Catlass::Arch::CrossCoreWaitFlag(sub1Done);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(aicDone);
        }
    }
}

namespace flash_kda {

void launch_persub_flag(const FwdParams &params, aclrtStream stream)
{
    const int block_dim = params.N * params.H;
    if (block_dim <= 0) {
        return;
    }
    FwdParams p = params;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&p.sync_base_addr));
    FlashKdaPerSubFlag<<<block_dim, nullptr, stream>>>(p);
}

}  // namespace flash_kda
