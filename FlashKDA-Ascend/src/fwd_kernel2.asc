/**
 * FlashKDA Ascend -- Kernel 2 (Recurrence): device entry point and launch.
 *
 * See fwd_kernel1.asc for why the entry and the <<<>>> launch share a
 * translation unit and why SetSyncBaseAddr must come first.
 *
 * The recurrence is sequential in chunks within a sequence, so the grid is one
 * core per (sequence, head) rather than per tile.
 */

#include "flash_kda/fwd.h"
#include "flash_kda/fwd_kernel2.hpp"
#include "catlass/arch/cross_core_sync.hpp"

#define FKDA_K2_ENTRY(NAME, METHOD)                                   \
    extern "C" CATLASS_GLOBAL void NAME(flash_kda::FwdParams params)  \
    {                                                                 \
        flash_kda::FwdRecurrenceKernel op;                            \
        op.METHOD(params);                                            \
    }

FKDA_K2_ENTRY(FlashKdaK2BuildU, RunBuildU)
FKDA_K2_ENTRY(FlashKdaK2PreGemms, RunPreGemms)
FKDA_K2_ENTRY(FlashKdaK2FinishOut, RunFinishOut)
FKDA_K2_ENTRY(FlashKdaK2PostGemms, RunPostGemms)
FKDA_K2_ENTRY(FlashKdaK2FinishChunk, RunFinishChunk)

extern "C" CATLASS_GLOBAL void FlashKdaK2InitState(flash_kda::FwdParams params)
{
    flash_kda::FwdRecurrenceKernel op;
    op.RunInitState(params);
}

extern "C" CATLASS_GLOBAL void FlashKdaK2StoreFinal(flash_kda::FwdParams params)
{
    flash_kda::FwdRecurrenceKernel op;
    op.RunStoreFinalState(params);
}

namespace flash_kda {

void launch_fwd_recurrence(const FwdParams& params, aclrtStream stream)
{
    const int block_dim = params.N * params.H;
    if (block_dim <= 0) {
        return;
    }

    // Worst-case chunk count across sequences; shorter ones return early.
    int maxChunks = 0;
    if (params.is_varlen == 0) {
        const int seqLen = params.T_total / params.N;
        maxChunks = (seqLen + CHUNK - 1) / CHUNK;
    } else {
        // total_tiles already bounds the sum; a per-sequence bound is enough.
        maxChunks = params.total_tiles;
    }

    FlashKdaK2InitState<<<block_dim, nullptr, stream>>>(params);

    // Five launches per chunk, ordered by the stream. This replaces two
    // cross-core handshakes per chunk, which deadlock from a Python extension.
    // params is passed by value, so each launch captures the chunk index as it
    // stood at launch time.
    FwdParams p = params;
    for (int c = 0; c < maxChunks; ++c) {
        p.chunk_idx = c;
        FlashKdaK2BuildU<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2PreGemms<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2FinishOut<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2PostGemms<<<block_dim, nullptr, stream>>>(p);
        FlashKdaK2FinishChunk<<<block_dim, nullptr, stream>>>(p);
    }

    FlashKdaK2StoreFinal<<<block_dim, nullptr, stream>>>(params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Cross-core handshake with a SINGLE kernel argument. The earlier probes took
// two and hung, which was the argument shape rather than the handshake -- this
// separates them. If it completes, kernel2's five-launches-per-chunk structure
// can collapse back into one kernel with the chunk loop inside.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncOneArg(flash_kda::FwdParams params)
{
    AscendC::SetSyncBaseAddr(params.sync_base_addr);

    Catlass::Arch::CrossCoreFlag elemReady{1};
    Catlass::Arch::CrossCoreFlag mmaReady{2};

    const int units = params.N * params.H;

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int>(core) >= units) {
            return;
        }
        if (AscendC::GetSubBlockIdx() != 0) {
            return;
        }
        for (int i = 0; i < 8; ++i) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int>(core) >= units) {
            return;
        }
        for (int i = 0; i < 8; ++i) {
            Catlass::Arch::CrossCoreWaitFlag(elemReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        }
    }
}

namespace flash_kda {

void launch_sync_onearg(const FwdParams &params, aclrtStream stream)
{
    const int block_dim = params.N * params.H;
    if (block_dim <= 0) {
        return;
    }
    FwdParams p = params;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&p.sync_base_addr));
    FlashKdaSyncOneArg<<<block_dim, nullptr, stream>>>(p);
}

}  // namespace flash_kda
