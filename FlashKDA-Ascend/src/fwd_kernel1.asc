/**
 * FlashKDA Ascend -- Kernel 1 (Prepare): device entry point and launch.
 *
 * This file must be compiled by the Ascend compiler; CMake selects it via the
 * .asc extension and a per-source LANGUAGE property. The kernel entry and the
 * <<<>>> launch have to live in the same translation unit, with a plain C++
 * wrapper that the host-side pybind translation unit can call.
 *
 * Pattern taken from catlass/examples/23_flash_attention_infer/fai_kernel.cpp
 * (entry) and fai.cpp (host launch), which is the closest in-tree example that
 * mixes AIC and AIV with cross-core synchronization.
 *
 * SetSyncBaseAddr must be the first statement in the entry. Without it every
 * CrossCoreSetFlag / CrossCoreWaitFlag in the kernel is silently inert -- the
 * AIC and AIV never actually synchronize. The inherited draft had no entry
 * function at all, so this was never set.
 */

#include "flash_kda/fwd.h"
#include "flash_kda/fwd_kernel1.hpp"

extern "C" CATLASS_GLOBAL void FlashKdaFwdPrepare(uint64_t hardwareSyncAddr, flash_kda::FwdParams params)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    flash_kda::FwdPrepareKernel op;
    op(params);
}

namespace flash_kda {

void launch_fwd_prepare(const FwdParams& params, aclrtStream stream)
{
    // One AIC (plus its paired AIVs) per (tile, head).
    const int block_dim = params.total_tiles * params.H;
    if (block_dim <= 0) {
        return;
    }

    uint64_t hardwareSyncAddr = 0;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void**>(&hardwareSyncAddr));

    FlashKdaFwdPrepare<<<block_dim, nullptr, stream>>>(hardwareSyncAddr, params);
}

}  // namespace flash_kda
