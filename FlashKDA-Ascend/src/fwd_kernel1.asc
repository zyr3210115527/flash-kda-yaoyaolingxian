#include <cstdio>
/**
 * FlashKDA Ascend -- Kernel 1 (Prepare): device entry point and launch.
 *
 * This file must be compiled by the Ascend compiler; CMake selects it via the
 * .asc extension and a per-source LANGUAGE property. The kernel entry and the
 * <<<>>> launch have to live in the same translation unit, with a plain C++
 * wrapper that the host-side pybind translation unit can call.
 *
 * Pattern taken from catlass/examples/23_flash_attention_infer/fai_kernel.cpp
 * (entry) and fai.cpp (host launch), which is the closest in-tree example that
 * mixes AIC and AIV with cross-core synchronization.
 *
 * SetSyncBaseAddr must be the first statement in the entry. Without it every
 * CrossCoreSetFlag / CrossCoreWaitFlag in the kernel is silently inert -- the
 * AIC and AIV never actually synchronize. The inherited draft had no entry
 * function at all, so this was never set.
 */

#include "flash_kda/fwd.h"
#include "flash_kda/fwd_kernel1.hpp"

extern "C" CATLASS_GLOBAL void FlashKdaFwdPrepare(uint64_t hardwareSyncAddr, flash_kda::FwdParams params)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    flash_kda::FwdPrepareKernel op;
    op(params);
}

namespace flash_kda {

void launch_fwd_prepare(const FwdParams& params, aclrtStream stream)
{
    // One AIC (plus its paired AIVs) per (tile, head).
    const int block_dim = params.total_tiles * params.H;
    if (block_dim <= 0) {
        return;
    }

    uint64_t hardwareSyncAddr = 0;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void**>(&hardwareSyncAddr));

    FlashKdaFwdPrepare<<<block_dim, nullptr, stream>>>(hardwareSyncAddr, params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Smallest possible kernel on this launch path, for isolating launch problems
// from kernel bodies. Writes one byte and returns; no sync, no Resource.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaNoop(GM_ADDR flag)
{
    if (AscendC::GetBlockIdx() == 0) {
        AscendC::GlobalTensor<int32_t> g;
        g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(flag));
        g.SetValue(0, 42);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                          AscendC::DcciDst::CACHELINE_OUT>(g);
    }
}

namespace flash_kda {

void launch_noop(GM_ADDR flag, aclrtStream stream)
{
    FlashKdaNoop<<<1, nullptr, stream>>>(flag);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Handshake-only kernel taking the real FwdParams by value. Isolates whether a
// ~150-byte by-value kernel argument is what breaks the cross-core handshake.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncOnly(uint64_t hardwareSyncAddr, flash_kda::FwdParams params)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    Catlass::Arch::CrossCoreFlag elemReady{flash_kda::K1_ELEM_READY};
    Catlass::Arch::CrossCoreFlag mmaReady{flash_kda::K1_MMA_READY};

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int>(core) >= params.total_tiles * params.H) {
            return;
        }
        if (AscendC::GetSubBlockIdx() == 0) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int>(core) >= params.total_tiles * params.H) {
            return;
        }
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
    }
}

namespace flash_kda {

void launch_sync_only(const FwdParams &params, aclrtStream stream)
{
    const int block_dim = params.total_tiles * params.H;
    if (block_dim <= 0) {
        return;
    }
    uint64_t hardwareSyncAddr = 0;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&hardwareSyncAddr));
    FlashKdaSyncOnly<<<block_dim, nullptr, stream>>>(hardwareSyncAddr, params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Identical handshake to FlashKdaSyncOnly, but with two scalar arguments rather
// than FwdParams by value. Isolates kernel argument size as the variable.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncSmall(uint64_t hardwareSyncAddr, int32_t units)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    Catlass::Arch::CrossCoreFlag elemReady{flash_kda::K1_ELEM_READY};
    Catlass::Arch::CrossCoreFlag mmaReady{flash_kda::K1_MMA_READY};

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int32_t>(core) >= units) {
            return;
        }
        if (AscendC::GetSubBlockIdx() == 0) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int32_t>(core) >= units) {
            return;
        }
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
    }
}

namespace flash_kda {

void launch_sync_small(int units, aclrtStream stream)
{
    if (units <= 0) {
        return;
    }
    uint64_t hardwareSyncAddr = 0;
    aclError rc = aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&hardwareSyncAddr));
    printf("[host] getHardwareSyncAddr rc=%d addr=0x%llx units=%d\n", (int)rc, (unsigned long long)hardwareSyncAddr, units);
    FlashKdaSyncSmall<<<units, nullptr, stream>>>(hardwareSyncAddr, static_cast<int32_t>(units));
}

}  // namespace flash_kda
