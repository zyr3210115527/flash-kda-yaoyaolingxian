#include <cstdio>
/**
 * FlashKDA Ascend -- Kernel 1 (Prepare): device entry point and launch.
 *
 * This file must be compiled by the Ascend compiler; CMake selects it via the
 * .asc extension and a per-source LANGUAGE property. The kernel entry and the
 * <<<>>> launch have to live in the same translation unit, with a plain C++
 * wrapper that the host-side pybind translation unit can call.
 *
 * Pattern taken from catlass/examples/23_flash_attention_infer/fai_kernel.cpp
 * (entry) and fai.cpp (host launch), which is the closest in-tree example that
 * mixes AIC and AIV with cross-core synchronization.
 *
 * SetSyncBaseAddr must be the first statement in the entry. Without it every
 * CrossCoreSetFlag / CrossCoreWaitFlag in the kernel is silently inert -- the
 * AIC and AIV never actually synchronize. The inherited draft had no entry
 * function at all, so this was never set.
 */

#include "flash_kda/fwd.h"
#include "flash_kda/fwd_kernel1.hpp"
#include "catlass/arch/cross_core_sync.hpp"  // only for the sync_only/sync_small diagnostics

extern "C" CATLASS_GLOBAL void FlashKdaPrepareAiv(flash_kda::FwdParams params)
{
    // This phase runs on one core type; the other returns immediately via
    // `if constexpr (g_coreType != ...)`. Without the annotation the launch is
    // a mix task and starts blocks on both, half of which exist only to return.
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    flash_kda::FwdPrepareKernel op;
    op.RunPrepare(params);
}

extern "C" CATLASS_GLOBAL void FlashKdaLMqkAic(flash_kda::FwdParams params)
{
    // This phase runs on one core type; the other returns immediately via
    // `if constexpr (g_coreType != ...)`. Without the annotation the launch is
    // a mix task and starts blocks on both, half of which exist only to return.
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    flash_kda::FwdPrepareKernel op;
    op.RunLMqk(params);
}

extern "C" CATLASS_GLOBAL void FlashKdaMaskAiv(flash_kda::FwdParams params)
{
    // This phase runs on one core type; the other returns immediately via
    // `if constexpr (g_coreType != ...)`. Without the annotation the launch is
    // a mix task and starts blocks on both, half of which exist only to return.
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    flash_kda::FwdPrepareKernel op;
    op.RunMask(params);
}

extern "C" CATLASS_GLOBAL void FlashKdaNeumannAic(flash_kda::FwdParams params)
{
    // This phase runs on one core type; the other returns immediately via
    // `if constexpr (g_coreType != ...)`. Without the annotation the launch is
    // a mix task and starts blocks on both, half of which exist only to return.
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
    flash_kda::FwdPrepareKernel op;
    op.RunNeumann(params);
}

namespace {

// Blocks past the physical core count only add dispatch overhead now that the
// phases grid-stride. ACL_DEV_ATTR_CUBE_CORE_NUM, not the AI_CORE_NUM of the
// similarly named aclDeviceInfo enum -- that is a different type and does not
// compile. Reports 20 on this 910B3.
int CubeCoreCount()
{
    static int cached = 0;
    if (cached == 0) {
        int64_t n = 0;
        if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &n) == ACL_SUCCESS && n > 0) {
            cached = static_cast<int>(n);
        } else {
            cached = 20;   // Atlas A2 fallback
        }
    }
    return cached;
}

}  // namespace

namespace flash_kda {

void launch_fwd_prepare(const FwdParams& params, aclrtStream stream)
{
    // One AIC (plus its paired AIVs) per (tile, head).
    const int units = params.total_tiles * params.H;
    if (units <= 0) {
        return;
    }
    const int cores = CubeCoreCount();
    const int block_dim = (units < cores) ? units : cores;

    // Four single-core-type launches on one stream. The stream orders them, so
    // no cross-core flags are needed -- and cross-core flags do not work from a
    // Python extension anyway (docs/debugging-notes.md).
    FlashKdaPrepareAiv<<<block_dim, nullptr, stream>>>(params);
    FlashKdaLMqkAic<<<block_dim, nullptr, stream>>>(params);
    FlashKdaMaskAiv<<<block_dim, nullptr, stream>>>(params);
    FlashKdaNeumannAic<<<block_dim, nullptr, stream>>>(params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Smallest possible kernel on this launch path, for isolating launch problems
// from kernel bodies. Writes one byte and returns; no sync, no Resource.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaNoop(GM_ADDR flag)
{
    if (AscendC::GetBlockIdx() == 0) {
        AscendC::GlobalTensor<int32_t> g;
        g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(flag));
        g.SetValue(0, 42);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                          AscendC::DcciDst::CACHELINE_OUT>(g);
    }
}

namespace flash_kda {

void launch_noop(GM_ADDR flag, aclrtStream stream)
{
    FlashKdaNoop<<<1, nullptr, stream>>>(flag);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Handshake-only kernel taking the real FwdParams by value. Isolates whether a
// ~150-byte by-value kernel argument is what breaks the cross-core handshake.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncOnly(uint64_t hardwareSyncAddr, flash_kda::FwdParams params)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    Catlass::Arch::CrossCoreFlag elemReady{1};
    Catlass::Arch::CrossCoreFlag mmaReady{2};

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int>(core) >= params.total_tiles * params.H) {
            return;
        }
        if (AscendC::GetSubBlockIdx() == 0) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int>(core) >= params.total_tiles * params.H) {
            return;
        }
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
    }
}

namespace flash_kda {

void launch_sync_only(const FwdParams &params, aclrtStream stream)
{
    const int block_dim = params.total_tiles * params.H;
    if (block_dim <= 0) {
        return;
    }
    uint64_t hardwareSyncAddr = 0;
    aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&hardwareSyncAddr));
    FlashKdaSyncOnly<<<block_dim, nullptr, stream>>>(hardwareSyncAddr, params);
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// Identical handshake to FlashKdaSyncOnly, but with two scalar arguments rather
// than FwdParams by value. Isolates kernel argument size as the variable.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaSyncSmall(uint64_t hardwareSyncAddr, int32_t units)
{
    AscendC::SetSyncBaseAddr(hardwareSyncAddr);

    Catlass::Arch::CrossCoreFlag elemReady{1};
    Catlass::Arch::CrossCoreFlag mmaReady{2};

    if constexpr (g_coreType == AscendC::AIV) {
        const uint32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
        if (static_cast<int32_t>(core) >= units) {
            return;
        }
        if (AscendC::GetSubBlockIdx() == 0) {
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
            Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_MTE3>(elemReady);
            Catlass::Arch::CrossCoreWaitFlag(mmaReady);
        }
    } else {
        const uint32_t core = AscendC::GetBlockIdx();
        if (static_cast<int32_t>(core) >= units) {
            return;
        }
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
        Catlass::Arch::CrossCoreWaitFlag(elemReady);
        Catlass::Arch::CrossCoreSetFlag<0x2, PIPE_FIX>(mmaReady);
    }
}

namespace flash_kda {

void launch_sync_small(int units, aclrtStream stream)
{
    if (units <= 0) {
        return;
    }
    uint64_t hardwareSyncAddr = 0;
    aclError rc = aclrtGetHardwareSyncAddr(reinterpret_cast<void **>(&hardwareSyncAddr));
    printf("[host] getHardwareSyncAddr rc=%d addr=0x%llx units=%d\n", (int)rc, (unsigned long long)hardwareSyncAddr, units);
    FlashKdaSyncSmall<<<units, nullptr, stream>>>(hardwareSyncAddr, static_cast<int32_t>(units));
}

}  // namespace flash_kda

// ---------------------------------------------------------------------------
// AIV-only kernel, no cross-core sync: real vector work through UB. If this
// completes inside the extension while the handshake variants hang, kernel1
// should be split into single-core-type launches ordered by the stream.
// ---------------------------------------------------------------------------
extern "C" CATLASS_GLOBAL void FlashKdaAivOnly(GM_ADDR src, GM_ADDR dst)
{
    if constexpr (g_coreType == AscendC::AIV) {
        if (AscendC::GetSubBlockIdx() != 0) {
            return;
        }
        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::VECCALC> ub;
        pipe.InitBuffer(ub, 2048);
        AscendC::LocalTensor<float> buf = ub.Get<float>();

        AscendC::GlobalTensor<float> gsrc;
        AscendC::GlobalTensor<float> gdst;
        gsrc.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(src));
        gdst.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(dst));

        AscendC::DataCopy(buf, gsrc, 128);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>((event_t)0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>((event_t)0);

        AscendC::Exp(buf, buf, 128);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>((event_t)0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>((event_t)0);

        AscendC::DataCopy(gdst, buf, 128);
    }
}

namespace flash_kda {

void launch_aiv_only(GM_ADDR src, GM_ADDR dst, aclrtStream stream)
{
    FlashKdaAivOnly<<<1, nullptr, stream>>>(src, dst);
}

}  // namespace flash_kda

// AIC-only control: does the cube run at all from this extension?
extern "C" CATLASS_GLOBAL void FlashKdaAicOnly(GM_ADDR flag)
{
    if constexpr (g_coreType == AscendC::AIC) {
        AscendC::GlobalTensor<int32_t> g;
        g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(flag));
        g.SetValue(0, 7);
        AscendC::DataCacheCleanAndInvalid<int32_t, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                          AscendC::DcciDst::CACHELINE_OUT>(g);
    }
}

namespace flash_kda {
void launch_aic_only(GM_ADDR flag, aclrtStream stream)
{
    FlashKdaAicOnly<<<1, nullptr, stream>>>(flag);
}
}
